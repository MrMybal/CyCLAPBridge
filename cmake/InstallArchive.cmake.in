# Rebuild the installed MSVC archive, retaining its compiled objects and symbols.
# Debug-only COFF sections and machine-specific archive member paths are omitted.
set(_archive "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_LIBDIR@/CyCLAPBridge.lib")
if(NOT EXISTS "${_archive}")
  message(FATAL_ERROR "Installed CyCLAPBridge archive is missing")
endif()
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 _id)
set(_work "@CMAKE_CURRENT_BINARY_DIR@/archive-install-${_id}")
file(MAKE_DIRECTORY "${_work}")
execute_process(COMMAND "@CYCLAPBRIDGE_LLVM_OBJCOPY@" --strip-debug "${_archive}" "${_work}/objects.lib" RESULT_VARIABLE _result ERROR_VARIABLE _error)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Could not prepare the installed archive: ${_result}")
endif()
execute_process(COMMAND "@CMAKE_AR@" /NOLOGO /LIST "${_work}/objects.lib" RESULT_VARIABLE _result OUTPUT_VARIABLE _listing ERROR_VARIABLE _error)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Could not enumerate installed archive objects")
endif()
string(REPLACE "\r" "" _listing "${_listing}")
string(REPLACE "\n" ";" _members "${_listing}")
set(_response "")
set(_index 0)
foreach(_member IN LISTS _members)
  string(STRIP "${_member}" _member)
  if(_member STREQUAL "")
    continue()
  endif()
  set(_part "Object${_index}.obj")
  execute_process(COMMAND "@CMAKE_AR@" /NOLOGO "/EXTRACT:${_member}" "/OUT:${_part}" "${_work}/objects.lib"
    WORKING_DIRECTORY "${_work}" RESULT_VARIABLE _result OUTPUT_QUIET ERROR_VARIABLE _error)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Could not preserve installed archive object ${_index}")
  endif()
  string(APPEND _response "${_part}\n")
  math(EXPR _index "${_index}+1")
endforeach()
if(_index EQUAL 0)
  message(FATAL_ERROR "The installed archive contains no compiled objects")
endif()
file(WRITE "${_work}/objects.rsp" "${_response}")
execute_process(COMMAND "@CMAKE_AR@" /NOLOGO /OUT:CyCLAPBridge.lib @objects.rsp WORKING_DIRECTORY "${_work}"
  RESULT_VARIABLE _result OUTPUT_QUIET ERROR_VARIABLE _error)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Could not rebuild the installed static archive")
endif()
file(COPY_FILE "${_work}/CyCLAPBridge.lib" "${_archive}" ONLY_IF_DIFFERENT)
message(STATUS "Installed release archive: ${_index} compiled objects retained")
