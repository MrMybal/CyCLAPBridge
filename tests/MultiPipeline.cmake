cmake_minimum_required(VERSION 3.27)
string(RANDOM LENGTH 10 ALPHABET abcdef0123456789 _id)
set(_root "${WORK}/formats-${_id}")
file(MAKE_DIRECTORY "${_root}")
function(convert tag source input target name)
  execute_process(COMMAND "${CLI}" convert --from "${source}" --input "${input}" --to "${target}"
    --output "${_root}/${tag}" --name "${name}" --build --cmake "${CMAKE_COMMAND}" ${ARGN}
    RESULT_VARIABLE _code OUTPUT_FILE "${_root}/${tag}.log" ERROR_FILE "${_root}/${tag}.errors")
  if(NOT _code EQUAL 0)
    message(FATAL_ERROR "${source}->${target} failed: ${_root}/${tag}.log")
  endif()
endfunction()
function(audio format path)
  execute_process(COMMAND "${HOST}" "${format}" "${path}" RESULT_VARIABLE _code
    OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
  if(NOT _code EQUAL 0)
    message(FATAL_ERROR "${format} acceptance failed: ${_output} ${_error}")
  endif()
  message(STATUS "${_output}")
endfunction()
convert(clap-lv2 clap "${FIXTURE}" lv2 "CLAP as LV2")
set(_lv2 "${_root}/clap-lv2/build/artifacts/Release/CLAP as LV2.lv2")
audio(lv2 "${_lv2}")
convert(lv2-clap lv2 "${_lv2}" clap "LV2 as CLAP")
audio(clap "${_root}/lv2-clap/build/artifacts/Release/LV2 as CLAP.clap")
convert(jsfx-clap jsfx "${JSFX}" clap "JSFX as CLAP")
audio(clap "${_root}/jsfx-clap/build/artifacts/Release/JSFX as CLAP.clap")
convert(jsfx-vst3 jsfx "${JSFX}" vst3 "JSFX as VST3")
set(_vst3 "${_root}/jsfx-vst3/build/artifacts/Release")
foreach(_notice vst3sdk.txt vst3-base.txt vst3-interfaces.txt vst3-public-sdk.txt Licensing.md runtimes/ysfx.txt)
  if(NOT EXISTS "${_vst3}/CyCLAPBridge-licenses/${_notice}")
    message(FATAL_ERROR "Missing multi-format license notice: ${_notice}")
  endif()
endforeach()
audio(vst3 "${_vst3}/JSFX as VST3.vst3")
convert(vst3-clap vst3 "${_vst3}/JSFX as VST3.vst3" clap "VST3 as CLAP" --resources "${_vst3}")
audio(clap "${_root}/vst3-clap/build/artifacts/Release/VST3 as CLAP.clap")
convert(jsfx-lv2 jsfx "${JSFX}" lv2 "JSFX as LV2")
audio(lv2 "${_root}/jsfx-lv2/build/artifacts/Release/JSFX as LV2.lv2")
