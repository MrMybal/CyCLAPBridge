cmake_minimum_required(VERSION 3.27)
string(RANDOM LENGTH 10 ALPHABET abcdef0123456789 _run)
set(_root "${WORK}/acceptance-${_run}")
file(MAKE_DIRECTORY "${_root}")
execute_process(COMMAND "${CLI}" capabilities RESULT_VARIABLE _code OUTPUT_VARIABLE _capabilities)
if(NOT _code EQUAL 0 OR _capabilities MATCHES "[Aa][Aa][Xx]")
  message(FATAL_ERROR "Removed AAX format is advertised by the CLI")
endif()
execute_process(COMMAND "${CLI}" convert --input "${FIXTURE}" --output "${_root}/removed-format"
  --to aax RESULT_VARIABLE _code OUTPUT_VARIABLE _output ERROR_VARIABLE _errors)
if(_code EQUAL 0 OR NOT _errors MATCHES "Unknown format: aax" OR EXISTS "${_root}/removed-format")
  message(FATAL_ERROR "CLI did not reject the removed AAX format without writing output")
endif()
execute_process(COMMAND "${CLI}" convert --aax-sdk "${_root}" RESULT_VARIABLE _code
  OUTPUT_VARIABLE _output ERROR_VARIABLE _errors)
if(_code EQUAL 0 OR NOT _errors MATCHES "Unknown option: --aax-sdk")
  message(FATAL_ERROR "CLI accepted the removed AAX SDK option")
endif()
execute_process(COMMAND "${CLI}" convert --input "${FIXTURE}" --output "${_root}/conversion with spaces"
  --name "CyBridge Acceptance" --build --cmake "${CMAKE_COMMAND}"
  RESULT_VARIABLE _code OUTPUT_FILE "${_root}/build.log" ERROR_FILE "${_root}/build-errors.log")
if(NOT _code EQUAL 0)
  message(FATAL_ERROR "Wrapper build failed: ${_root}/build.log and build-errors.log")
endif()
set(_artifacts "${_root}/conversion with spaces/build/artifacts/Release")
file(COPY "${_artifacts}/" DESTINATION "${_root}/relocated package")
execute_process(COMMAND "${SMOKE}" "${_root}/relocated package/CyBridge Acceptance.vst3"
  RESULT_VARIABLE _code OUTPUT_VARIABLE _output ERROR_VARIABLE _errors)
if(NOT _code EQUAL 0)
  message(FATAL_ERROR "Relocated VST3 acceptance failed: ${_output} ${_errors}")
endif()
foreach(_notice clap-wrapper.txt clap.txt vst3sdk.txt vst3-base.txt vst3-interfaces.txt vst3-public-sdk.txt CyCLAPBridge.txt Licensing.md)
  if(NOT EXISTS "${_root}/relocated package/CyCLAPBridge-licenses/${_notice}")
    message(FATAL_ERROR "Missing license notice in distributable artifacts: ${_notice}")
  endif()
endforeach()
message(STATUS "${_output}")
