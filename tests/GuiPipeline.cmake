cmake_minimum_required(VERSION 3.27)
string(RANDOM LENGTH 8 ALPHABET abcdef0123456789 _id)
set(_root "${WORK}/gui-${_id}")
file(MAKE_DIRECTORY "${_root}")
function(convert tag source input target name)
  execute_process(COMMAND "${CLI}" convert --from "${source}" --input "${input}" --to "${target}"
    --output "${_root}/${tag}" --name "${name}" --build --cmake "${CMAKE_COMMAND}" ${ARGN}
    RESULT_VARIABLE _code OUTPUT_FILE "${_root}/${tag}.log" ERROR_FILE "${_root}/${tag}.errors")
  if(NOT _code EQUAL 0)
    message(FATAL_ERROR "GUI conversion failed: ${_root}/${tag}.log and .errors")
  endif()
endfunction()
function(gui format path)
  execute_process(COMMAND "${HOST}" "${format}" "${path}" RESULT_VARIABLE _code OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(NOT _code EQUAL 0)
    message(FATAL_ERROR "${format} GUI acceptance failed (${path}): ${_out} ${_err}")
  endif()
  message(STATUS "${_out}")
endfunction()
