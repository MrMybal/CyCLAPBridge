function(run_cli expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE actual
    OUTPUT_VARIABLE result ERROR_VARIABLE diagnostic)
  if(NOT actual EQUAL expected)
    message(FATAL_ERROR "CLI returned ${actual}, expected ${expected}: ${result}${diagnostic}")
  endif()
  set(output "${result}" PARENT_SCOPE)
endfunction()

run_cli(0 --help)
if(NOT output MATCHES "capabilities" OR NOT output MATCHES "tools describe")
  message(FATAL_ERROR "Top-level help lost existing or new commands")
endif()
run_cli(0 tools --help)
if(NOT output MATCHES "--mcp-url")
  message(FATAL_ERROR "Missing tools help")
endif()
run_cli(0 capabilities)
if(NOT output MATCHES "JSFX -> CLAP")
  message(FATAL_ERROR "Legacy capabilities output changed")
endif()
run_cli(0 inspect --from jsfx --input "${FIXTURE}")
if(NOT output MATCHES "parameters")
  message(FATAL_ERROR "Legacy inspection did not return plug-in metadata")
endif()
run_cli(0 tools list)
string(JSON count LENGTH "${output}" tools)
if(NOT count EQUAL 4)
  message(FATAL_ERROR "Expected the four existing Studio tools")
endif()
run_cli(0 tools describe convert_plugin)
string(JSON name GET "${output}" tool name)
string(JSON result_type GET "${output}" tool outputSchema type)
if(NOT name STREQUAL "convert_plugin" OR NOT result_type STREQUAL "object")
  message(FATAL_ERROR "Incomplete CLI description")
endif()
run_cli(0 tools call list_formats)
string(JSON format GET "${output}" result inspection_formats 0)
if(NOT format STREQUAL "clap")
  message(FATAL_ERROR "CLI did not invoke the shared registry")
endif()
run_cli(2 tools call list_formats --args not-json)
string(JSON code GET "${output}" error code)
if(NOT code STREQUAL "InvalidArguments")
  message(FATAL_ERROR "Malformed arguments did not return a JSON error")
endif()
run_cli(3 tools call convert_plugin)
string(JSON code GET "${output}" error code)
if(NOT code STREQUAL "StudioRequired")
  message(FATAL_ERROR "Instance-dependent tools must refuse headless execution")
endif()
