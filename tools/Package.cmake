cmake_minimum_required(VERSION 3.27)
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
  set(_preset windows-x64)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  set(_preset linux)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
  set(_preset macos)
else()
  message(FATAL_ERROR "No Studio package preset for ${CMAKE_HOST_SYSTEM_NAME}")
endif()
foreach(_step configure build package)
  if(_step STREQUAL "configure")
    set(_args --preset "${_preset}")
  elseif(_step STREQUAL "build")
    set(_args --build --preset "${_preset}" --parallel)
  else()
    set(_args --build --preset "${_preset}" --target package)
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" ${_args} WORKING_DIRECTORY "${_root}" RESULT_VARIABLE _result)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "${_step} failed for ${_preset}: ${_result}")
  endif()
endforeach()
message(STATUS "Native package generated under dist/packages (${_preset})")
